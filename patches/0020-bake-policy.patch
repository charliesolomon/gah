From 050cfa8cb2db25258135693b25793bfa413e2705 Mon Sep 17 00:00:00 2001
From: csolomon <charliesolomon@gmail.com>
Date: Fri, 28 Aug 2026 20:05:12 -0700
Subject: [PATCH] bake-policy: force-load bundled GAH policy in published artifacts

A `gah-policy/extensions/` directory shipped beside the built entry point
is force-loaded, and extension auto-discovery is disabled. This gives
published artifacts the same posture bin/gah enforces in a dev checkout
(--no-extensions plus explicit --extension flags), so the policy pack is
not something a user can opt out of by installing the package directly.

The directory is created by scripts/bundle-policy.sh at publish time and is
absent in dev builds, so the existsSync guard makes this a no-op locally.

Regenerated against v0.84.4, with two changes:

1. Context only: main.ts's import block gained setCapabilityOverrides
   (pi-tui) and normalizeSessionName (./cli/args.ts), which is why the
   v0.79.1 patch stopped applying. The real anchor -- the resolveCliPaths
   block -- was untouched.

2. A real fix. v0.84.4 bundles the CLI, and the bundler emits this code into
   dist/bundle/chunks/, so import.meta.url is one level deeper than the
   published gah-policy/ directory. The single-candidate lookup resolved to
   dist/bundle/chunks/gah-policy/extensions, which does not exist -- and the
   failure mode is SILENT: existsSync returns false and the policy pack
   simply never loads. Probe a couple of levels up instead of assuming the
   module sits at the bundle root.

Caught by the fault-injection step in docs/WORKFLOW.md; verified after the
fix with a probe extension dropped into the baked directory, which loaded
and ran.

---
 packages/coding-agent/src/main.ts | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/packages/coding-agent/src/main.ts b/packages/coding-agent/src/main.ts
index e92b49bea..6769849b4 100644
--- a/packages/coding-agent/src/main.ts
+++ b/packages/coding-agent/src/main.ts
@@ -5,7 +5,10 @@
  * createAgentSession() options. The SDK does the heavy lifting.
  */
 
+import { existsSync, readdirSync } from "node:fs";
+import { dirname, resolve } from "node:path";
 import { createInterface } from "node:readline";
+import { fileURLToPath } from "node:url";
 import { type ImageContent, modelsAreEqual } from "@earendil-works/pi-ai";
 import { setCapabilityOverrides } from "@earendil-works/pi-tui";
 import chalk from "chalk";
@@ -705,7 +708,30 @@ export async function main(args: string[], options?: MainOptions) {
 	const trustPromptMode: AppMode = parsed.help || parsed.listModels !== undefined ? "print" : appMode;
 	const projectTrustByCwd = new Map<string, boolean>();
 
-	const resolvedExtensionPaths = resolveCliPaths(cwd, parsed.extensions);
+	let resolvedExtensionPaths = resolveCliPaths(cwd, parsed.extensions);
+	// GAH: a `gah-policy/extensions/` dir next to the built entry point (created
+	// by the publish pipeline, absent in dev builds) is force-loaded and turns
+	// off extension auto-discovery — the same posture bin/gah enforces with
+	// --no-extensions + explicit --extension flags.
+	// Search upward from the running module rather than assuming it sits at the
+	// bundle root: the bundler emits this code into dist/bundle/chunks/, so
+	// import.meta.url is one level deeper than the published gah-policy/ dir.
+	// Getting this wrong fails SILENTLY — existsSync is simply false and the
+	// policy pack never loads — so probe a couple of levels.
+	const gahPolicyStart = dirname(fileURLToPath(import.meta.url));
+	const gahPolicyExtDir = [
+		resolve(gahPolicyStart, "gah-policy", "extensions"),
+		resolve(gahPolicyStart, "..", "gah-policy", "extensions"),
+		resolve(gahPolicyStart, "..", "..", "gah-policy", "extensions"),
+	].find((candidate) => existsSync(candidate));
+	if (gahPolicyExtDir) {
+		const baked = readdirSync(gahPolicyExtDir)
+			.filter((f) => /\.(ts|js|mjs)$/.test(f))
+			.sort()
+			.map((f) => resolve(gahPolicyExtDir, f));
+		resolvedExtensionPaths = [...baked, ...(resolvedExtensionPaths ?? [])];
+		parsed.noExtensions = true;
+	}
 	const resolvedSkillPaths = resolveCliPaths(cwd, parsed.skills);
 	const resolvedPromptTemplatePaths = resolveCliPaths(cwd, parsed.promptTemplates);
 	const resolvedThemePaths = resolveCliPaths(cwd, parsed.themes);
-- 
