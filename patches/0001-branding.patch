From: csolomon <charliesolomon@gmail.com>
Date: Wed, 23 Sep 2026 11:29:58 -0700
Subject: [PATCH] =?UTF-8?q?=3D=3FUTF-8=3Fq=3Fbranding:=3D20rebrand=3D20pi?=
 =?UTF-8?q?=3D20=3DE2=3D86=3D92=3D20gah=3F=3D=20MIME-Version:=201.0=20Cont?=
 =?UTF-8?q?ent-Type:=20text/plain;=20charset=3DUTF-8=20Content-Transfer-En?=
 =?UTF-8?q?coding:=208bit?=

Set piConfig.name='gah' and configDir='.gah' in coding-agent
package.json. PI's APP_NAME cascade picks this up everywhere:
banner ('gah v0.84.4'), env vars (GAH_CODING_AGENT_DIR), process
title, User-Agent, debug log filename, slash-command labels, session
export filename. Global config lives in ~/.gah/agent/.

Rename the bin entry from 'pi' to 'gah' for npm-install hygiene
(GAH itself launches via bin/gah wrapper, so this only matters if
the package is ever installed standalone).

Replace the startup onboarding hint with a GAH-specific one
referencing the policy + audit posture.

Regenerated against v0.84.4: the bin target moved from dist/cli.js to
dist/bundle/cli.js, which is why the v0.79.1 patch no longer applied.
Re-authored 2026-09-02 (#35 follow-up): the startup banner advertised
"! bash" whether or not a shell was allowed. The two ! hints now appear
only when the policy's exported tool set (GAH_EFFECTIVE_TOOLS) contains
bash or powershell; absent that variable (no policy pack loaded) they
show as upstream would.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011it956DeV4unyWw5VyvkDD

Re-authored 2026-09-23 (#112): the bin rename is also made in
package-lock.json, whose workspace entry for coding-agent records the bin
map. Without it `npm install` reconciles the lockfile to the patched
manifest, rewrites that one line, and leaves vendor/pi dirty, which is
what made `git pull --ff-only` refuse on the agent host. `npm ci` never
writes the lockfile, so it was unaffected; `npm install` now is too.
---
 package-lock.json                                      |  2 +-
 packages/coding-agent/package.json                     |  5 +++--
 .../src/modes/interactive/interactive-mode.ts          | 10 ++++++----
 3 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/package-lock.json b/package-lock.json
index a4b5de131..a3dc7f69f 100644
--- a/package-lock.json
+++ b/package-lock.json
@@ -5416,7 +5416,7 @@
 				"yaml": "2.9.0"
 			},
 			"bin": {
-				"pi": "dist/bundle/cli.js"
+				"gah": "dist/bundle/cli.js"
 			},
 			"devDependencies": {
 				"@earendil-works/pi-client": "^0.87.1",
diff --git a/packages/coding-agent/package.json b/packages/coding-agent/package.json
index 62c01de66..d070a0f5f 100644
--- a/packages/coding-agent/package.json
+++ b/packages/coding-agent/package.json
@@ -4,10 +4,11 @@
 	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
 	"type": "module",
 	"piConfig": {
-		"configDir": ".pi"
+		"name": "gah",
+		"configDir": ".gah"
 	},
 	"bin": {
-		"pi": "dist/bundle/cli.js"
+		"gah": "dist/bundle/cli.js"
 	},
 	"main": "./dist/index.js",
 	"types": "./dist/index.d.ts",
diff --git a/packages/coding-agent/src/modes/interactive/interactive-mode.ts b/packages/coding-agent/src/modes/interactive/interactive-mode.ts
index 968f74140..43e159bf7 100644
--- a/packages/coding-agent/src/modes/interactive/interactive-mode.ts
+++ b/packages/coding-agent/src/modes/interactive/interactive-mode.ts
@@ -960,6 +960,7 @@ export class InteractiveMode {
 			// Build startup instructions using keybinding hint helpers
 			const hint = (keybinding: AppKeybinding, description: string) => keyHint(keybinding, description);
 
+			const gahShellAllowed = /(^|,)(bash|powershell)(,|$)/.test(process.env.GAH_EFFECTIVE_TOOLS ?? "bash");
 			const expandedInstructions = [
 				hint("app.interrupt", "to interrupt"),
 				hint("app.clear", "to clear"),
@@ -974,8 +975,9 @@ export class InteractiveMode {
 				hint("app.thinking.toggle", "to expand thinking"),
 				hint("app.editor.external", "for external editor"),
 				rawKeyHint("/", "for commands"),
-				rawKeyHint("!", "to run bash"),
-				rawKeyHint("!!", "to run bash (no context)"),
+				// GAH: the shell escape exists only when the policy allows a shell
+				// (policy.ts exports the enforced set before this banner is built).
+				...(gahShellAllowed ? [rawKeyHint("!", "to run bash"), rawKeyHint("!!", "to run bash (no context)")] : []),
 				hint("app.message.followUp", "to queue follow-up"),
 				hint("app.message.dequeue", "to edit all queued messages"),
 				hint("app.clipboard.pasteImage", "to paste image (with text fallback)"),
@@ -985,7 +987,7 @@ export class InteractiveMode {
 				hint("app.interrupt", "interrupt"),
 				rawKeyHint(`${keyText("app.clear")}/${keyText("app.exit")}`, "clear/exit"),
 				rawKeyHint("/", "commands"),
-				rawKeyHint("!", "bash"),
+				...(gahShellAllowed ? [rawKeyHint("!", "bash")] : []),
 				hint("app.tools.expand", "more"),
 			].join(theme.fg("muted", " · "));
 			const compactOnboarding = theme.fg(
@@ -994,7 +996,7 @@ export class InteractiveMode {
 			);
 			const onboarding = theme.fg(
 				"dim",
-				`Pi can explain its own features and look up its docs. Ask it how to use or extend Pi.`,
+				`GAH enforces a tool allowlist and audits every call. Ask the agent what it can and can't do.`,
 			);
 			this.builtInHeader = new ExpandableText(
 				() => `${logo}\n${compactInstructions}\n${compactOnboarding}\n\n${onboarding}`,
