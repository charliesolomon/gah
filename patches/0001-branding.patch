 packages/coding-agent/package.json             |  5 +++--
 .../src/modes/interactive/interactive-mode.ts  | 18 +++++++++---------
 3 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/package-lock.json b/package-lock.json
index 40fad3ada..b86e492ef 100644
--- a/package-lock.json
+++ b/package-lock.json
@@ -5708,7 +5708,7 @@
