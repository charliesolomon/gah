#!/usr/bin/env bash
#
# gah — launch PI with GAH policy-pack loaded, ignoring any user-global
# extensions/skills/themes that PI would otherwise auto-discover.
#
# The wrapper exists so that the policy enforced in this repo is the policy
# the user actually gets, regardless of what's in ~/.pi/agent/.
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CA_DIR="$HERE/vendor/pi/packages/coding-agent"
POLICY_DIR="$HERE/packages/policy-pack/extensions"
TEMPLATE_DIR="$HERE/templates/skills-repo"
KB_TEMPLATE_DIR="$HERE/templates/kb-repo"

# Which scaffold a knowledge base carries. Written on init and on update, read
# at launch to say when the tooling in a knowledge base has fallen behind --
# otherwise nobody finds out, because the scripts keep working and simply lack
# the fix.
#
# It is git's tree hash for templates/kb-repo, not the gah version or commit:
# that changes exactly when the scaffold's own contents change, so an unrelated
# commit does not make every knowledge base look stale, and it is the same value
# computed from bash or PowerShell, so a knowledge base updated on a host and
# read on a workstation agrees with itself. Empty outside a git checkout, and
# nothing warns on an empty value.
kb_scaffold_id() {
  git -C "$HERE" rev-parse --short "HEAD:templates/kb-repo" 2>/dev/null || true
}

# The same, for the skills scaffold. Only two of the files gah ships there are
# ever refreshed -- see `gah update-skills` -- but the marker covers the whole
# template, so a change to any of it prompts a look.
skills_scaffold_id() {
  git -C "$HERE" rev-parse --short "HEAD:templates/skills-repo" 2>/dev/null || true
}

# What `gah update-skills` maintains. Everything else in a skills repository is
# the organisation's from the moment it runs `gah init`: its own skills, its
# prompts, its README. These two starter skills are gah's guidance rather than
# theirs -- skill-authoring tells them how to write the next skill, and
# onboarding derives its answer from the loaded set -- and the setup steps are
# mechanism. That is the whole line, and it is drawn narrowly on purpose.
SKILLS_MANAGED="skills/onboarding skills/skill-authoring setup"

# --- Subcommands -----------------------------------------------------------
# One list, used three ways: to recognise the token, to tell --help what this
# launcher can do (GAH_SCAFFOLD_COMMANDS, below), and by the packaged launcher
# to refuse the lot. It was three separate lists until the help page fell three
# subcommands behind without anyone noticing.
GAH_SCAFFOLD_COMMANDS="init init-kb update-kb update-skills"
export GAH_SCAFFOLD_COMMANDS

# The subcommand is not necessarily the first argument: a wrapper commonly
# injects flags ahead of the person's own arguments --
#   gah() { ~/gah/bin/gah --skill ~/skills "$@"; }
# -- so `gah init-kb <dir>` arrives as `--skill <dir> init-kb <dir>`. Find the
# first bare subcommand token instead, ignoring one that is the value of a
# preceding flag (`--skill init-kb` names a directory, not a subcommand).
subcommand=""
subtarget=""
prev=""
for arg in "$@"; do
  for known in $GAH_SCAFFOLD_COMMANDS; do
    [ "$arg" = "$known" ] || continue
    case "$prev" in -*) break ;; esac
    subcommand="$arg"
    break
  done
  if [ -n "$subcommand" ] && [ "$arg" != "$subcommand" ]; then subtarget="$arg"; break; fi
  prev="$arg"
done

# --- gah init --------------------------------------------------------------
# Handled before the build check on purpose: a new deployment scaffolds its
# skills repo first, and should not need a built PI to do it. Also breaks the
# circularity of a launcher that refuses to start without skills.
if [ "$subcommand" = "init" ]; then
  target="$subtarget"
  [ -n "$target" ] || { echo "usage: gah init <directory>" >&2; exit 2; }
  [ -d "$TEMPLATE_DIR" ] || { echo "gah: template missing at $TEMPLATE_DIR" >&2; exit 1; }
  if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
    echo "gah: $target exists and is not empty — refusing to overwrite" >&2
    exit 1
  fi
  mkdir -p "$target"
  cp -R "$TEMPLATE_DIR/." "$target/"
  chmod +x "$target"/setup/*.sh 2>/dev/null || true
  printf 'scaffold %s\n' "$(skills_scaffold_id)" >"$target/.skills-scaffold"
  cat <<EOF

Created a skills repository in $target

  skills/     onboarding and skill-authoring, to start with
  setup/      steps that run before each session
  context/    what your organization knows

Next:
  cd $target && git init && git add . && git commit -m "Initial skills repo"

Then point a session at it:
  GAH_SKILLS_DIR=$(cd "$target" && pwd)/skills gah

EOF
  exit 0
fi

# --- gah init-kb -----------------------------------------------------------
# The knowledge base is the other half of the context the concept rests on, and
# unlike skills it is optional: a deployment without one simply has no kb-*
# skills. Scaffolded separately for that reason, and because the two are
# different repositories with different review rules -- skills are procedure,
# the knowledge base is fact.
if [ "$subcommand" = "init-kb" ]; then
  target="$subtarget"
  [ -n "$target" ] || { echo "usage: gah init-kb <directory>" >&2; exit 2; }
  [ -d "$KB_TEMPLATE_DIR" ] || { echo "gah: template missing at $KB_TEMPLATE_DIR" >&2; exit 1; }
  if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
    echo "gah: $target exists and is not empty — refusing to overwrite" >&2
    exit 1
  fi
  mkdir -p "$target"
  cp -R "$KB_TEMPLATE_DIR/." "$target/"
  chmod +x "$target"/bin/*.sh 2>/dev/null || true
  printf 'scaffold %s\n' "$(kb_scaffold_id)" >"$target/.kb-scaffold"
  cat <<EOF

Created a knowledge base in $target

  articles/   what your organization knows, one Markdown file each
  skills/     kb-search, kb-article, kb-propose, kb-curate
  bin/        the scripts those skills call (.sh and .ps1)

Next:
  cd $target && git init && git add . && git commit -m "Initial knowledge base"

Then point a session at it:
  GAH_KB_DIR=$(cd "$target" && pwd) gah

Ask it something you already know the answer to. It should tell you that
nothing covers it yet, and offer to record the gap — that is the loop starting.

EOF
  exit 0
fi

# --- gah update-kb ---------------------------------------------------------
# The scaffold ships tooling -- the scripts and the four skills -- into a
# repository that then fills up with an organisation's own articles. When the
# tooling gains a fix, `init-kb` is no help: it refuses a directory that has
# anything in it, which by then is every real knowledge base. This refreshes the
# tooling in place and leaves articles/ alone.
#
# Nothing is merged: the shipped files are written over whatever is there, and
# git is the review. That is why it insists on a clean tree -- so `git diff`
# afterwards shows exactly what changed, including any local edit it replaced,
# and `git checkout` puts it back.
if [ "$subcommand" = "update-kb" ]; then
  target="$subtarget"
  [ -n "$target" ] || { echo "usage: gah update-kb <directory>" >&2; exit 2; }
  [ -d "$KB_TEMPLATE_DIR" ] || { echo "gah: template missing at $KB_TEMPLATE_DIR" >&2; exit 1; }
  if [ ! -d "$target/articles" ] || [ ! -d "$target/bin" ]; then
    echo "gah: $target does not look like a knowledge base (no articles/ and bin/)." >&2
    echo "  To create one:  gah init-kb $target" >&2
    exit 1
  fi
  force=0
  case " $* " in *" --force "*) force=1 ;; esac

  # Already current: say so and touch nothing. Checked before the clean-tree
  # rule below, because a no-op is harmless and refusing one is baffling when
  # the uncommitted changes in question are the ones a previous run just made.
  want_id="$(kb_scaffold_id)"
  have_id="$(sed -n 's/^scaffold //p' "$target/.kb-scaffold" 2>/dev/null || true)"
  if [ "$force" -eq 0 ] && [ -n "$want_id" ] && [ "$have_id" = "$want_id" ]; then
    echo "The knowledge base tooling in $target is already current ($want_id)."
    echo "  To write the shipped files over local edits anyway:  gah update-kb $target --force"
    exit 0
  fi

  is_git=0
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 && is_git=1
  if [ "$is_git" -eq 1 ] && [ "$force" -eq 0 ] && [ -n "$(git -C "$target" status --porcelain 2>/dev/null)" ]; then
    echo "gah: $target has uncommitted changes." >&2
    echo "  Commit or stash them first, so the update shows up cleanly in git diff." >&2
    echo "  Or pass --force to write over them anyway." >&2
    exit 3
  fi
  [ "$is_git" -eq 0 ] && echo "gah: $target is not a git repository, so there is no undo. Continuing." >&2

  was="$(sed -n 's/^scaffold //p' "$target/.kb-scaffold" 2>/dev/null || true)"; : "${was:=unknown}"
  # Only the tooling. articles/ is the organisation's, and README.md and
  # .gitignore are theirs to have edited; extra files of their own in these
  # directories are left in place, since nothing is deleted.
  for d in bin skills templates prompts; do
    [ -d "$KB_TEMPLATE_DIR/$d" ] || continue
    mkdir -p "$target/$d"
    cp -R "$KB_TEMPLATE_DIR/$d/." "$target/$d/"
  done
  chmod +x "$target"/bin/*.sh 2>/dev/null || true
  printf 'scaffold %s\n' "$(kb_scaffold_id)" >"$target/.kb-scaffold"

  echo ""
  echo "Updated the knowledge base tooling in $target"
  echo "  was: $was"
  echo "  now: $(kb_scaffold_id)"
  echo ""
  if [ "$is_git" -eq 1 ]; then
    changed="$(git -C "$target" status --porcelain -- bin skills templates prompts .kb-scaffold 2>/dev/null)"
    if [ -n "$changed" ]; then
      echo "Changed:"
      printf '%s\n' "$changed" | sed 's/^/  /'
      echo ""
      echo "Review with:  git -C $target diff"
      echo "Undo with:    git -C $target checkout -- bin skills templates prompts .kb-scaffold"
    else
      echo "Nothing changed — the tooling was already current."
    fi
  fi
  echo ""
  echo "articles/ was not touched."
  echo ""
  exit 0
fi

# --- gah update-skills -----------------------------------------------------
# A skills repository is the organisation's, not gah's -- with two exceptions.
# `skill-authoring` is gah's guidance on how to write the next skill, and
# `onboarding` answers "what can I do with this?" from the loaded set; both
# improve upstream, and until now an improvement reached only deployments
# created after it. The setup steps are mechanism and travel with them.
#
# Everything else -- their skills, their prompts, their README, their context --
# is untouched. The line is drawn narrowly on purpose: a tool that rewrites an
# organisation's own skills is a tool nobody runs twice.
if [ "$subcommand" = "update-skills" ]; then
  target="$subtarget"
  [ -n "$target" ] || { echo "usage: gah update-skills <directory>" >&2; exit 2; }
  [ -d "$TEMPLATE_DIR" ] || { echo "gah: template missing at $TEMPLATE_DIR" >&2; exit 1; }
  # Accept either the repository or its skills/ directory, since GAH_SKILLS_DIR
  # points at the latter and that is what people have in their hands.
  case "$target" in */skills|*/skills/) target="$(dirname "${target%/}")" ;; esac
  if [ ! -d "$target/skills" ]; then
    echo "gah: $target does not look like a skills repository (no skills/)." >&2
    echo "  To create one:  gah init $target" >&2
    exit 1
  fi
  force=0
  case " $* " in *" --force "*) force=1 ;; esac

  want_id="$(skills_scaffold_id)"
  have_id="$(sed -n 's/^scaffold //p' "$target/.skills-scaffold" 2>/dev/null || true)"
  if [ "$force" -eq 0 ] && [ -n "$want_id" ] && [ "$have_id" = "$want_id" ]; then
    echo "The starter skills in $target are already current ($want_id)."
    echo "  To write the shipped files over local edits anyway:  gah update-skills $target --force"
    exit 0
  fi

  is_git=0
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 && is_git=1
  if [ "$is_git" -eq 1 ] && [ "$force" -eq 0 ] && [ -n "$(git -C "$target" status --porcelain 2>/dev/null)" ]; then
    echo "gah: $target has uncommitted changes." >&2
    echo "  Commit or stash them first, so the update shows up cleanly in git diff." >&2
    echo "  Or pass --force to write over them anyway." >&2
    exit 3
  fi
  [ "$is_git" -eq 0 ] && echo "gah: $target is not a git repository, so there is no undo. Continuing." >&2

  refreshed=""
  skipped=""
  for rel in $SKILLS_MANAGED; do
    [ -e "$TEMPLATE_DIR/$rel" ] || continue
    if [ -e "$target/$rel" ]; then
      :
    elif [ "$is_git" -eq 1 ] && [ -n "$(git -C "$target" log --diff-filter=A --format=%H -1 -- "$rel" 2>/dev/null)" ]; then
      # It was here and was deleted. Putting it back would undo a decision.
      skipped="$skipped  $rel (removed here — left out)\n"
      continue
    fi
    if [ -d "$TEMPLATE_DIR/$rel" ]; then
      mkdir -p "$target/$rel"
      cp -R "$TEMPLATE_DIR/$rel/." "$target/$rel/"
    else
      mkdir -p "$(dirname "$target/$rel")"
      cp "$TEMPLATE_DIR/$rel" "$target/$rel"
    fi
    refreshed="$refreshed  $rel\n"
  done
  chmod +x "$target"/setup/*.sh 2>/dev/null || true
  printf 'scaffold %s\n' "$want_id" >"$target/.skills-scaffold"

  echo ""
  echo "Updated the starter skills in $target"
  echo "  was: ${have_id:-unknown}"
  echo "  now: ${want_id:-unknown}"
  echo ""
  [ -n "$refreshed" ] && { echo "Refreshed:"; printf "%b" "$refreshed"; }
  [ -n "$skipped" ] && { echo "Left alone:"; printf "%b" "$skipped"; }
  if [ "$is_git" -eq 1 ]; then
    changed="$(git -C "$target" status --porcelain 2>/dev/null)"
    if [ -n "$changed" ]; then
      echo ""
      echo "Changed:"
      printf '%s\n' "$changed" | sed 's/^/  /'
      echo ""
      echo "Review with:  git -C $target diff"
    fi
  fi
  echo ""
  echo "Your own skills, prompts and context were not touched."
  echo ""
  exit 0
fi

# --- skills are required ---------------------------------------------------
# GAH exists to run skills; a session with none is a misconfiguration, not a
# lighter mode. Without this the policy layer loads with nothing to govern and
# the agent declines ordinary work, because the system prompt is written around
# skills that are not there. A deployment launcher (deploy/host/gah-launch) may
# satisfy this itself by cloning SKILLS_REPO and passing --skill.
#
# Only --skill counts. --no-skills means "do not auto-discover", not "I want
# none" -- gah-launch passes it on every launch to pin the loaded set, so
# honouring it here would exempt the shared host from the check entirely.
skills_configured=0
case " $* " in *" --skill "*) skills_configured=1 ;; esac
# --help and --version answer without a skills repo and start nothing, so they
# also skip the setup steps below.
info_only=0
case " $* " in *" --help "*|*" -h "*|*" --version "*|*" -v "*) info_only=1; skills_configured=1 ;; esac
[ -n "${GAH_ALLOW_NO_SKILLS:-}" ] && skills_configured=1
if [ -n "${GAH_SKILLS_DIR:-}" ] && [ -d "$GAH_SKILLS_DIR" ]; then skills_configured=1; fi
if [ "$skills_configured" -eq 0 ]; then
  cat >&2 <<EOF
GAH works with your organization's shared agents and skills.
Set them up using:

  gah init <directory>

Then start a session with:

  GAH_SKILLS_DIR=<directory>/skills gah

A knowledge base is optional and scaffolded separately (docs/KB.md):

  gah init-kb <directory>   then   GAH_KB_DIR=<directory> gah

Refresh an existing one's scripts and skills, leaving its articles alone:

  gah update-kb <directory>

Refresh the starter skills gah maintains, leaving your own alone:

  gah update-skills <directory>

Or pass one directly for a single run:  gah --skill <path>

To start a deliberately empty session:   GAH_ALLOW_NO_SKILLS=1 gah
EOF
  exit 1
fi

# Resolve the entry point from the package's own `bin` field rather than
# hardcoding it. Upstream moved this from dist/cli.js to dist/bundle/cli.js in
# v0.84.4 — a change no patch covers, so apply-patches.sh reported success while
# the wrapper silently pointed at a file that no longer existed. Read it from
# package.json and this survives the next move too.
PI_CLI=""
if [ -f "$CA_DIR/package.json" ]; then
  rel="$(node -e "
    const fs=require('node:fs');
    const b=JSON.parse(fs.readFileSync('$CA_DIR/package.json','utf8')).bin;
    console.log(typeof b === 'string' ? b : Object.values(b || {})[0] || '');
  " 2>/dev/null || true)"
  [ -n "$rel" ] && PI_CLI="$CA_DIR/$rel"
fi
# Fall back to the two known layouts if package.json could not be read.
for cand in "$PI_CLI" "$CA_DIR/dist/bundle/cli.js" "$CA_DIR/dist/cli.js"; do
  if [ -n "$cand" ] && [ -f "$cand" ]; then PI_CLI="$cand"; break; fi
done

if [ -z "$PI_CLI" ] || [ ! -f "$PI_CLI" ]; then
  cat >&2 <<EOF
gah: PI build is missing under
  $CA_DIR/dist/

Run the build first:
  make install && make build-all
EOF
  exit 1
fi

# Dev default: expose built-in Anthropic models (patch 0010 hides everything
# otherwise). Deployments override or unset this; published artifacts have no
# wrapper and default to deny-all.
export GAH_BUILTIN_MODELS="${GAH_BUILTIN_MODELS-anthropic/*}"
# "none" means none, same word as bin\gah.ps1 (where an empty string cannot be
# set); patch 0010 treats empty as none.
[ "$GAH_BUILTIN_MODELS" = "none" ] && export GAH_BUILTIN_MODELS=""

# Workstation default: read ~/.gah/agent/models.json. A workstation exists to
# point at whatever endpoint its user has, so requiring an opt-out variable only
# produced a config file that was written, then silently ignored. Deployments
# set this explicitly -- deploy/host/gah-launch defaults it to deny, because on
# a shared host models.json IS the way around the built-in allowlist.
export GAH_ALLOW_MODELS_JSON="${GAH_ALLOW_MODELS_JSON-1}"

# Workstation default: no egress restriction. Patch 0011 refuses any HTTP
# request whose host is not in GAH_ALLOWED_HOSTS, and unset means deny-all;
# a workstation points at whatever endpoint its user has, so the wrapper opts
# out with `*`. Set it to lock a workstation down (docs/PROVIDERS.md), e.g.
# GAH_ALLOWED_HOSTS='api.anthropic.com,platform.claude.com' for Anthropic OAuth.
export GAH_ALLOWED_HOSTS="${GAH_ALLOWED_HOSTS-*}"

# --no-extensions disables auto-discovery from ~/.pi/agent and .pi/ ;
# explicit --extension flags re-add exactly what GAH ships.
skill_args=()
[ -n "${GAH_SKILLS_DIR:-}" ] && [ -d "${GAH_SKILLS_DIR:-}" ] && skill_args=(--skill "$GAH_SKILLS_DIR")

# Prompt templates: the skills repo's prompts/ (sibling of skills/) holds the
# organisation's slash commands, reviewed like skills. Discovery stays on, so a
# person's own ~/.gah/agent/prompts/ still loads alongside them.
if [ -n "${GAH_SKILLS_DIR:-}" ] && [ -d "$(dirname "$GAH_SKILLS_DIR")/prompts" ]; then
  skill_args+=(--prompt-template "$(dirname "$GAH_SKILLS_DIR")/prompts")
fi

# Say when the starter skills gah maintains are older than this build. Silent
# when the repository has none of them (a deployment that removed both has
# decided, and does not need telling again) or when this is not a checkout.
if [ -n "${GAH_SKILLS_DIR:-}" ] && [ "$info_only" -eq 0 ] && [ -d "$TEMPLATE_DIR" ]; then
  skills_root="$(dirname "$GAH_SKILLS_DIR")"
  sk_want="$(skills_scaffold_id)"
  sk_have="$(sed -n 's/^scaffold //p' "$skills_root/.skills-scaffold" 2>/dev/null || true)"
  sk_present=0
  for rel in $SKILLS_MANAGED; do [ -e "$skills_root/$rel" ] && sk_present=1; done
  if [ -n "$sk_want" ] && [ "$sk_present" -eq 1 ] && [ "$sk_have" != "$sk_want" ]; then
    echo "gah: the starter skills in $skills_root are ${sk_have:+at $sk_have, }behind this checkout ($sk_want)" >&2
    echo "     refresh them with:  gah update-skills $skills_root" >&2
  fi
fi

# The knowledge base (optional, docs/KB.md) carries its own skills and prompts,
# so a deployment that has one gets the kb-* skills and a deployment that does
# not is unaffected. Its skills load AFTER the organisation's: where both define
# a name, the organisation's wins, which is the right way round for a set that
# ships as a scaffold.
if [ -n "${GAH_KB_DIR:-}" ]; then
  if [ -d "$GAH_KB_DIR/skills" ]; then
    skill_args+=(--skill "$GAH_KB_DIR/skills")
  elif [ "$info_only" -eq 0 ]; then
    echo "gah: GAH_KB_DIR=$GAH_KB_DIR has no skills/ — knowledge base not loaded" >&2
  fi
  [ -d "$GAH_KB_DIR/prompts" ] && skill_args+=(--prompt-template "$GAH_KB_DIR/prompts")
  # Say when the tooling in the knowledge base is older than this build. The
  # scripts keep working when they fall behind; they simply lack the fix, which
  # is a failure nobody notices without being told.
  if [ "$info_only" -eq 0 ] && [ -d "$KB_TEMPLATE_DIR" ]; then
    kb_want="$(kb_scaffold_id)"
    kb_have="$(sed -n 's/^scaffold //p' "$GAH_KB_DIR/.kb-scaffold" 2>/dev/null || true)"
    # Silent when this is not a checkout (nothing to compare, and no way to
    # update from here anyway).
    if [ -n "$kb_want" ] && [ "$kb_have" != "$kb_want" ]; then
      echo "gah: this knowledge base's scripts and skills are ${kb_have:+at $kb_have, }behind the scaffold in this checkout ($kb_want)" >&2
      echo "     refresh them with:  gah update-kb $GAH_KB_DIR" >&2
    fi
  fi
fi

# --- Onboarding / setup steps -------------------------------------------------
# The skills repo may ship numbered, idempotent setup steps (setup/NN-*.sh) that
# run in the terminal before the TUI, so secrets are collected without ever
# passing through the model. They live next to skills/ in the repo `gah init`
# scaffolds, so they are found relative to GAH_SKILLS_DIR's parent -- which also
# means a bare --skill run loads no setup steps, having no repo to find them in.
#
# Steps are agent-authored code, same trust level as the skills themselves;
# change control is the skills repo's review. Failure is non-fatal, matching
# deploy/host/gah-launch. GAH_SKIP_SETUP=1 skips them.
if [ -n "${GAH_SKILLS_DIR:-}" ] && [ -z "${GAH_SKIP_SETUP:-}" ] && [ "$info_only" -eq 0 ]; then
  setup_dir="$(dirname "$GAH_SKILLS_DIR")/setup"
  if [ -d "$setup_dir" ]; then
    for step in "$setup_dir"/[0-9]*.sh; do
      [ -e "$step" ] || continue
      bash "$step" || echo "gah: setup step $(basename "$step") failed - continuing" >&2
    done
  fi
fi

exec node "$PI_CLI" \
  --no-extensions \
  "${skill_args[@]}" \
  --extension "$POLICY_DIR/policy.ts" \
  --extension "$POLICY_DIR/branding.ts" \
  --extension "$POLICY_DIR/providers.ts" \
  --extension "$POLICY_DIR/skills-freshness.ts" \
  "$@"
