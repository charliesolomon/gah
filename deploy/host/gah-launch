#!/usr/bin/env bash
#
# gah-launch — per-user entry point for GAH sessions on a shared agent host.
#
# Reads the root-owned manifest for $USER, syncs the approved skills repo,
# exports the deployment's policy env, and execs the policed gah wrapper.
# Users never invoke this with arguments; it is started by gah-session
# (their login shell) inside tmux.
#
# One flag exists for administrators testing under someone else's account:
#   --no-mark-seen   this session never advances the person's "skills seen"
#                    marker, so the skills-update summary (#91) still shows
#                    on their own next launch. Run it as the user directly,
#                    bypassing the login shell (which drops arguments):
#                      sudo -u <user> -H /usr/local/bin/gah-launch --no-mark-seen
#
# Headless mode runs one prompt and exits, for scheduled jobs (cron) under an
# account that has a manifest but no person behind it:
#
#   gah-launch --print <prompt-file> [--only-if <check>] [--model <provider/id>]
#              [--timeout <seconds>]
#
#   <prompt-file>  path inside the synced skills repo; its text is the prompt.
#                  What a job asks for is reviewed like the skills themselves.
#   --only-if      path inside the skills repo, run after the sync. Exit 0 =
#                  run the prompt, 1 = nothing to do (exit 0, no model call),
#                  anything else = error (exit with that status).
#   --model        model to use; still subject to GAH_BUILTIN_MODELS.
#   --timeout      seconds before the run is killed (default 600; exit 124).
#
# An unattended run reads input it did not choose, and the account's home is
# writable by the agent it runs. So nothing a previous run left behind may
# steer the next one: the skills checkout (and the knowledge base, if any) is
# hard-reset and cleaned to the fetched commit even when the fetch fails,
# personal skills are not loaded, setup steps do not run, the session starts in
# a fresh empty directory with context-file discovery off, and stdin is closed.
# Exit status is gah's own: 0 ok, non-zero on a provider or launcher failure.
#
set -euo pipefail

HEADLESS="" PROMPT_FILE="" ONLY_IF="" RUN_MODEL="" RUN_TIMEOUT="600"
need_value() { [ -n "${2:-}" ] || { echo "gah-launch: $1 needs a value" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
	case "$1" in
		--no-mark-seen) export GAH_SKILLS_NO_MARK_SEEN=1; shift ;;
		--print)   need_value "$1" "${2:-}"; HEADLESS=1; PROMPT_FILE="$2"; shift 2 ;;
		--only-if) need_value "$1" "${2:-}"; ONLY_IF="$2"; shift 2 ;;
		--model)   need_value "$1" "${2:-}"; RUN_MODEL="$2"; shift 2 ;;
		--timeout) need_value "$1" "${2:-}"; RUN_TIMEOUT="$2"; shift 2 ;;
		*) echo "gah-launch: unknown argument '$1' (see the header of $0)" >&2; exit 2 ;;
	esac
done
if [ -z "$HEADLESS" ] && [ -n "$ONLY_IF$RUN_MODEL" ]; then
	echo "gah-launch: --only-if and --model only apply with --print" >&2; exit 2
fi
case "$RUN_TIMEOUT" in ''|*[!0-9]*) echo "gah-launch: --timeout takes whole seconds" >&2; exit 2 ;; esac
if [ -n "$HEADLESS" ]; then
	# No person sees a "what changed" summary, so never consume one.
	export GAH_SKILLS_NO_MARK_SEEN=1
fi

# A path inside the skills repo, as a job names it: relative, no "..".
repo_path_ok() {
	case "$1" in
		/*|..|../*|*/..|*/../*) return 1 ;;
	esac
	return 0
}
if [ -n "$HEADLESS" ]; then
	repo_path_ok "$PROMPT_FILE" || { echo "gah-launch: --print takes a path inside the skills repo" >&2; exit 2; }
	[ -z "$ONLY_IF" ] || repo_path_ok "$ONLY_IF" || { echo "gah-launch: --only-if takes a path inside the skills repo" >&2; exit 2; }
fi

GAH_HOME="/opt/gah"
CONF_DIR="/etc/gah"
# cron sets LOGNAME and HOME but not always USER.
USER="${USER:-$(id -un)}"
export USER
CONF="$CONF_DIR/users.d/$USER.conf"

fail() { echo "gah: $*" >&2; exit 1; }
warn() { echo "gah: $*" >&2; }

[ -x "$GAH_HOME/bin/gah" ] || fail "no gah build at $GAH_HOME — run setup.sh on this host"
[ -f "$CONF" ] || fail "no manifest for '$USER' at $CONF — ask the administrator to run gah-adduser $USER"

# The manifest is deployment policy. Refuse to run one an agent could edit.
owner="$(stat -c %U "$CONF")"
[ "$owner" = "root" ] || fail "$CONF must be owned by root (found: $owner)"

# tmux passes terminal query replies (DA1/DA2/XTVERSION) through to the active
# pane as input. With echo on and nothing reading them, the pane prints junk
# like ^[[>0;10;1c. Clearing afterwards still shows a flash, because the tty
# echoes each byte the moment it lands — so echo has to be off BEFORE they
# arrive, i.e. before the skills sync we spend seconds in. The trap guarantees
# the agent never inherits a terminal with echo disabled.
_tty_saved=""
if [ -t 0 ]; then
	_tty_saved="$(stty -g 2>/dev/null || true)"
	[ -n "$_tty_saved" ] && trap 'stty "$_tty_saved" 2>/dev/null || true' EXIT INT TERM
	stty -echo 2>/dev/null || true
fi

# set -a: every var the manifest sets is exported — deployment knobs the skills
# repo's scripts read (an API URL, a credentials file path) must reach the
# session and its tools.
set -a
# shellcheck source=/dev/null
source "$CONF"
set +a

# Release notes the administrator keeps for everyone on this host (#117):
# /etc/gah/whats-new.md, one `## ` section per announcement, newest first. A
# manifest can point one user elsewhere. The policy pack shows each person the
# sections they have not seen; upstream's changelog is cut to one line (0003).
if [ -z "${GAH_WHATS_NEW:-}" ] && [ -f "$CONF_DIR/whats-new.md" ]; then
	export GAH_WHATS_NEW="$CONF_DIR/whats-new.md"
fi

: "${SKILLS_REPO:?SKILLS_REPO not set in $CONF}"
SKILLS_BRANCH="${SKILLS_BRANCH:-main}"
SKILLS_SUBDIR="${SKILLS_SUBDIR:-skills}"
SKILLS_DIR="$HOME/.gah/skills-repo"
SKILLS_SSH_KEY="${SKILLS_SSH_KEY:-$CONF_DIR/skills-deploy-key}"

# An agent's own skills. Deliberately outside the shared checkout, which is
# hard-reset on every launch: personal work must survive that. MY_SKILLS_REPO is
# optional — set it to back the directory with the agent's own repository, which
# makes the work recoverable and lets a useful skill be promoted into the shared
# set. Unset, it is just a local directory.
MY_SKILLS_DIR="${MY_SKILLS_DIR:-$HOME/.gah/my-skills}"
MY_SKILLS_REPO="${MY_SKILLS_REPO:-}"
MY_SKILLS_BRANCH="${MY_SKILLS_BRANCH:-main}"

# The knowledge base: optional, and the only checkout here the agent WRITES to.
# Unset KB_REPO means this deployment has no knowledge base and no kb-* skills.
KB_REPO="${KB_REPO:-}"
KB_BRANCH="${KB_BRANCH:-main}"
KB_DIR="${KB_DIR:-$HOME/.gah/kb}"

# --- Sync the skills checkout -------------------------------------------------
# The repo is authoritative: every launch hard-resets to origin/<branch>, so
# improvements land by PR merge and local edits never drift. Network failure
# is non-fatal — the existing checkout keeps working offline.

# Never prompt (fresh accounts have no known_hosts; a hidden host-key prompt
# would hang the launch until the timeout). BatchMode makes failures fast.
GIT_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new"
if [ -f "$SKILLS_SSH_KEY" ]; then
	export GIT_SSH_COMMAND="ssh -i $SKILLS_SSH_KEY -o IdentitiesOnly=yes $GIT_SSH_OPTS"
else
	export GIT_SSH_COMMAND="ssh $GIT_SSH_OPTS"
fi

if [ -d "$SKILLS_DIR/.git" ]; then
	if timeout 30 git -C "$SKILLS_DIR" fetch --quiet origin "$SKILLS_BRANCH"; then
		git -C "$SKILLS_DIR" checkout --quiet "$SKILLS_BRANCH" 2>/dev/null \
			|| git -C "$SKILLS_DIR" checkout --quiet -b "$SKILLS_BRANCH" "origin/$SKILLS_BRANCH"
		git -C "$SKILLS_DIR" reset --hard --quiet "origin/$SKILLS_BRANCH"
	else
		warn "skills update failed — continuing with the existing checkout"
	fi
else
	timeout 120 git clone --quiet --branch "$SKILLS_BRANCH" "$SKILLS_REPO" "$SKILLS_DIR" \
		|| warn "skills clone failed — starting without skills"
fi
if [ -n "$HEADLESS" ] && [ -d "$SKILLS_DIR/.git" ]; then
	# Unattended: the checkout is nobody's work in progress, and a previous run
	# could have edited or added files in it. Return it to the fetched commit,
	# untracked files included, whether or not this run's fetch succeeded.
	git -C "$SKILLS_DIR" checkout --quiet --force "$SKILLS_BRANCH" 2>/dev/null || true
	git -C "$SKILLS_DIR" reset --hard --quiet "origin/$SKILLS_BRANCH" \
		|| fail "headless: cannot reset the skills checkout to origin/$SKILLS_BRANCH"
	git -C "$SKILLS_DIR" clean -fdxq
fi

# --- Sync personal skills (optional) -------------------------------------------
# Note the asymmetry with the shared checkout above, which is `reset --hard`:
# here it is `pull --ff-only`, because personal skills are edited in place and
# uncommitted work must survive a launch. A failure is never fatal — the agent
# keeps whatever is on disk.
if [ -n "$HEADLESS" ]; then
	# Personal skills belong to a person. An unattended account has none, and a
	# directory a previous run could write to must not become instructions.
	:
elif [ -n "$MY_SKILLS_REPO" ]; then
	if [ -d "$MY_SKILLS_DIR/.git" ]; then
		timeout 30 git -C "$MY_SKILLS_DIR" pull --ff-only --quiet 2>/dev/null \
			|| warn "personal skills not updated — continuing with the local copy"
	else
		timeout 120 git clone --quiet --branch "$MY_SKILLS_BRANCH" \
			"$MY_SKILLS_REPO" "$MY_SKILLS_DIR" 2>/dev/null \
			|| warn "personal skills clone failed — continuing without them"
	fi
else
	mkdir -p "$MY_SKILLS_DIR" 2>/dev/null || true
fi

# --- Sync the knowledge base (optional) ---------------------------------------
# Note the asymmetry with the shared skills checkout, which is `reset --hard`:
# this one is the agent's own workbench. A draft article, or a branch waiting to
# be pushed, is work in progress that a launch must not destroy -- so an unclean
# checkout is left exactly as it is and reported, and only a clean one on the
# default branch is fast-forwarded. The repo is still authoritative; it is just
# never authoritative at the cost of somebody's unpushed article.
if [ -n "$KB_REPO" ]; then
	if [ -d "$KB_DIR/.git" ]; then
		kb_branch_now="$(git -C "$KB_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
		if [ -n "$(git -C "$KB_DIR" status --porcelain 2>/dev/null)" ]; then
			warn "knowledge base has uncommitted changes — left as it is (propose them with kb-propose)"
		elif [ "$kb_branch_now" != "$KB_BRANCH" ]; then
			warn "knowledge base is on branch '$kb_branch_now' — left as it is (finish or push it, then switch back to $KB_BRANCH)"
		elif timeout 30 git -C "$KB_DIR" fetch --quiet origin "$KB_BRANCH"; then
			git -C "$KB_DIR" merge --ff-only --quiet "origin/$KB_BRANCH" 2>/dev/null \
				|| warn "knowledge base could not fast-forward — continuing with the local copy"
		else
			warn "knowledge base not updated — continuing with the local copy"
		fi
	else
		timeout 120 git clone --quiet --branch "$KB_BRANCH" "$KB_REPO" "$KB_DIR" \
			|| warn "knowledge base clone failed — continuing without it"
	fi
	if [ -n "$HEADLESS" ] && [ -d "$KB_DIR/.git" ]; then
		# Same rule as the skills checkout: an unattended account has no drafts
		# to protect, so the knowledge base is returned to the fetched commit.
		timeout 30 git -C "$KB_DIR" fetch --quiet origin "$KB_BRANCH" \
			|| warn "knowledge base not updated — resetting to the last fetched commit"
		git -C "$KB_DIR" checkout --quiet --force "$KB_BRANCH" 2>/dev/null || true
		git -C "$KB_DIR" reset --hard --quiet "origin/$KB_BRANCH" \
			|| fail "headless: cannot reset the knowledge base to origin/$KB_BRANCH"
		git -C "$KB_DIR" clean -fdxq
	fi
	# The scripts and skills locate the knowledge base through this.
	[ -d "$KB_DIR" ] && export GAH_KB_DIR="$KB_DIR"
fi

# --- Onboarding / setup steps ---------------------------------------------------
# The skills repo may ship numbered, idempotent setup steps (setup/NN-*.sh)
# that run in the terminal before the TUI — so secrets (e.g. helpdesk
# credentials) are collected without ever passing through the model. Steps
# are agent-authored code, same trust level as the skills themselves; change
# control is the skills repo's PR gate. Failure is non-fatal.

# Swallow whatever arrived while echo was off, then hand back a clean terminal:
# the setup steps below are interactive and need echo for the username prompt.
if [ -t 0 ]; then
	while IFS= read -r -t 0.2 -n 256 _drain 2>/dev/null; do :; done
	unset _drain
	[ -n "$_tty_saved" ] && stty "$_tty_saved" 2>/dev/null || true
	printf '\033[2J\033[H'
fi

if [ -z "$HEADLESS" ] && [ -d "$SKILLS_DIR/setup" ]; then
	for step in "$SKILLS_DIR"/setup/[0-9]*.sh; do
		[ -e "$step" ] || continue
		bash "$step" || warn "setup step $(basename "$step") failed — continuing"
	done
fi

# --- Deployment env -----------------------------------------------------------
# Export explicitly: `source` does not export, and GAH_BUILTIN_MODELS must be
# *set* (even if empty) so bin/gah's anthropic/* dev default never applies on
# this host. Empty = deny-all; the manifest grants what this user may see.
# IAM remains the hard enforcement layer (docs/PROVIDERS.md).

export GAH_BUILTIN_MODELS="${GAH_BUILTIN_MODELS-}"
# Empty = models.json is ignored. Exported even when unset so a user's own
# environment cannot switch it on: models.json carries its own baseUrl and
# apiKey, so honouring one here would route around the allowlist entirely.
export GAH_ALLOW_MODELS_JSON="${GAH_ALLOW_MODELS_JSON-}"
export GAH_ALLOW_TOOLS="${GAH_ALLOW_TOOLS-}"
# Empty = no HTTP request leaves the process (patch 0011). The manifest names
# the inference hosts, e.g. bedrock-runtime.us-west-1.amazonaws.com. Exported
# even when unset so bin/gah's workstation default (`*`) never applies here.
export GAH_ALLOWED_HOSTS="${GAH_ALLOWED_HOSTS-}"
[ -n "${AWS_PROFILE:-}" ] && export AWS_PROFILE
[ -n "${GAH_PROVIDERS_FILE:-}" ] && export GAH_PROVIDERS_FILE

# Staff can't self-update; the build is pinned by the deployment (gah-update).
# Redundant since 0013-offline-runtime forces offline mode in the binary, kept
# as a belt-and-braces statement of intent. GAH_* names are mirrored onto
# upstream's PI_* by the binary (patch 0002).
export GAH_SKIP_VERSION_CHECK=1

# --- Launch -------------------------------------------------------------------
# --no-skills disables auto-discovery (~/.gah/agent/skills, <cwd>/.gah/skills);
# the explicit --skill path below is still loaded — same pinning philosophy as
# bin/gah uses for extensions. Sessions start in ~/work, not $HOME.

if [ -n "$HEADLESS" ]; then
	# A fresh, empty directory per run, removed afterwards: nothing a previous
	# run wrote is within reach of context-file discovery or relative paths.
	WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/gah-run.XXXXXX")"
	trap 'rm -rf "$WORKDIR"' EXIT
else
	WORKDIR="${WORKDIR:-$HOME/work}"
	mkdir -p "$WORKDIR"
fi
cd "$WORKDIR"

# Skills come from two places, and a personal skill of the same name wins.
#
# The harness does NOT deduplicate: loadSourcedSkills() pushes every skill it
# finds from every --skill path, so passing both directories wholesale would load
# two skills with the same name and leave the model to guess. Precedence has to
# be resolved here.
#
# It is resolved by selection: --skill accepts an individual skill directory (a
# directory containing SKILL.md loads exactly that skill and stops), so shared
# skills that a personal skill shadows are simply never passed. Nothing is copied
# or symlinked, so paths referenced inside a skill still resolve.
#
# A skill's name is its frontmatter `name:` if present, otherwise its directory
# name — the same rule the loader uses — so shadowing is detected the way the
# harness would see it.
skill_name_of() {
	local dir="$1" file="$1/SKILL.md" name=""
	[ -f "$file" ] || return 1
	name=$(awk '
		/^---[[:space:]]*$/ { fence++; next }
		fence == 1 && /^name:[[:space:]]*/ {
			sub(/^name:[[:space:]]*/, "")
			gsub(/^["'"'"']|["'"'"']$/, "")
			print; exit
		}
		fence > 1 { exit }
	' "$file" 2>/dev/null)
	[ -n "$name" ] || name=$(basename "$dir")
	printf '%s\n' "$name"
}

skill_args=()
personal_names=" "
shared_names=" "

# Personal skills first: they are the ones that win, so they define the shadow set.
if [ -z "$HEADLESS" ] && [ -d "$MY_SKILLS_DIR" ]; then
	for d in "$MY_SKILLS_DIR"/*/; do
		[ -d "$d" ] || continue
		d="${d%/}"
		n=$(skill_name_of "$d") || continue
		personal_names="${personal_names}${n} "
		skill_args+=(--skill "$d")
	done
fi

if [ -d "$SKILLS_DIR/$SKILLS_SUBDIR" ]; then
	shared_count=0
	for d in "$SKILLS_DIR/$SKILLS_SUBDIR"/*/; do
		[ -d "$d" ] || continue
		d="${d%/}"
		n=$(skill_name_of "$d") || continue
		case "$personal_names" in
			*" $n "*)
				# Loud on purpose: a shared skill can carry a fix, and being
				# shadowed without notice is how that fix goes missing.
				warn "personal skill '$n' shadows the shared one — the shared version is NOT loaded"
				continue
				;;
		esac
		skill_args+=(--skill "$d")
		shared_names="${shared_names}${n} "
		shared_count=$((shared_count + 1))
	done
	[ "$shared_count" -eq 0 ] && warn "no shared skills loaded from $SKILLS_DIR/$SKILLS_SUBDIR"
else
	warn "no skills at $SKILLS_DIR/$SKILLS_SUBDIR — launching without shared skills"
fi

# The knowledge base ships the kb-* skills that operate it, so a deployment with
# one gets them and a deployment without one is untouched. Loaded last: where the
# organisation has written its own skill of the same name, that one wins, because
# these arrive as a scaffold and theirs is a decision.
if [ -n "${GAH_KB_DIR:-}" ] && [ -d "$GAH_KB_DIR/skills" ]; then
	kb_count=0
	for d in "$GAH_KB_DIR"/skills/*/; do
		[ -d "$d" ] || continue
		d="${d%/}"
		n=$(skill_name_of "$d") || continue
		case "$personal_names" in
			*" $n "*) warn "personal skill '$n' shadows the knowledge base one — the KB version is NOT loaded"; continue ;;
		esac
		case "$shared_names" in
			*" $n "*) warn "shared skill '$n' shadows the knowledge base one — the KB version is NOT loaded"; continue ;;
		esac
		skill_args+=(--skill "$d")
		kb_count=$((kb_count + 1))
	done
	[ "$kb_count" -eq 0 ] && warn "knowledge base at $GAH_KB_DIR has no skills — it will not be searchable"
fi

# Refuse rather than warn. A session with no skills is a misconfiguration: the
# system prompt is written around skills that are not there, so the agent
# declines ordinary work and the user cannot tell why. The warnings above say
# which half failed -- the clone, or the repo's contents.
if [ ${#skill_args[@]} -eq 0 ]; then
	fail "no skills loaded, refusing to launch.
  Shared repo:   $SKILLS_REPO (branch $SKILLS_BRANCH, subdir $SKILLS_SUBDIR)
  Clone target:  $SKILLS_DIR
Check the warnings above: either the clone failed or the repo has no skills.
To start a deliberately empty session:  GAH_ALLOW_NO_SKILLS=1 $GAH_HOME/bin/gah --no-skills"
fi

# Prompt templates: the shared repo's prompts/ holds the organisation's slash
# commands (/brief, /handoff, ...), reviewed like skills. Discovery is left on,
# so a user's own ~/.gah/agent/prompts/ loads alongside them -- they are text
# expansions the person could have typed, so there is nothing to pin.
[ -d "$SKILLS_DIR/prompts" ] && skill_args+=(--prompt-template "$SKILLS_DIR/prompts")
[ -n "${GAH_KB_DIR:-}" ] && [ -d "$GAH_KB_DIR/prompts" ] && skill_args+=(--prompt-template "$GAH_KB_DIR/prompts")

# bin/gah publishes the scaffolding subcommands it handles so --help can list
# them. None is reachable from here: this is a login shell that starts a session
# with the arguments below and never forwards the user's own. Clearing it keeps
# the help page honest for the people who only ever arrive this way.
export GAH_SCAFFOLD_COMMANDS=""

if [ -n "$HEADLESS" ]; then
	[ -f "$SKILLS_DIR/$PROMPT_FILE" ] || fail "headless: no prompt file '$PROMPT_FILE' in the skills repo"
	prompt="$(cat "$SKILLS_DIR/$PROMPT_FILE")"
	[ -n "${prompt//[[:space:]]/}" ] || fail "headless: prompt file '$PROMPT_FILE' is empty"
	if [ -n "$ONLY_IF" ]; then
		[ -x "$SKILLS_DIR/$ONLY_IF" ] || fail "headless: no executable check '$ONLY_IF' in the skills repo"
		set +e
		"$SKILLS_DIR/$ONLY_IF" </dev/null
		check=$?
		set -e
		case "$check" in
			0) ;;
			1) exit 0 ;;
			*) warn "headless: check '$ONLY_IF' failed (exit $check) — prompt not run"; exit "$check" ;;
		esac
	fi
	model_args=()
	[ -n "$RUN_MODEL" ] && model_args=(--model "$RUN_MODEL")
	set +e
	timeout --kill-after=30 "$RUN_TIMEOUT" "$GAH_HOME/bin/gah" --no-skills --no-context-files \
		"${skill_args[@]}" "${model_args[@]}" -p "$prompt" </dev/null
	status=$?
	set -e
	[ "$status" -eq 124 ] && warn "headless: run killed after ${RUN_TIMEOUT}s"
	exit "$status"
fi

exec "$GAH_HOME/bin/gah" --no-skills "${skill_args[@]}"
