#!/usr/bin/env bash
#
# gah-launch — per-user entry point for GAH sessions on a shared agent host.
#
# Reads the root-owned manifest for $USER, syncs the approved skills repo,
# exports the deployment's policy env, and execs the policed gah wrapper.
# Users never invoke this with arguments; it is started by gah-session
# (their login shell) inside tmux.
#
set -euo pipefail

GAH_HOME="/opt/gah"
CONF_DIR="/etc/gah"
CONF="$CONF_DIR/users.d/$USER.conf"

fail() { echo "gah: $*" >&2; exit 1; }
warn() { echo "gah: $*" >&2; }

[ -x "$GAH_HOME/bin/gah" ] || fail "no gah build at $GAH_HOME — run setup.sh on this host"
[ -f "$CONF" ] || fail "no manifest for '$USER' at $CONF — ask the administrator to run gah-adduser $USER"

# The manifest is deployment policy. Refuse to run one an agent could edit.
owner="$(stat -c %U "$CONF")"
[ "$owner" = "root" ] || fail "$CONF must be owned by root (found: $owner)"

# tmux passes terminal query replies (DA1/DA2/XTVERSION) through to the active
# pane as input. With echo on and nothing reading them, the pane prints junk
# like ^[[>0;10;1c. Clearing afterwards still shows a flash, because the tty
# echoes each byte the moment it lands — so echo has to be off BEFORE they
# arrive, i.e. before the skills sync we spend seconds in. The trap guarantees
# the agent never inherits a terminal with echo disabled.
_tty_saved=""
if [ -t 0 ]; then
	_tty_saved="$(stty -g 2>/dev/null || true)"
	[ -n "$_tty_saved" ] && trap 'stty "$_tty_saved" 2>/dev/null || true' EXIT INT TERM
	stty -echo 2>/dev/null || true
fi

# set -a: every var the manifest sets is exported — deployment knobs like
# GRACE_TICKETS_DIR/GRACE_TICKETS_ENV must reach the session and its tools.
set -a
# shellcheck source=/dev/null
source "$CONF"
set +a

: "${SKILLS_REPO:?SKILLS_REPO not set in $CONF}"
SKILLS_BRANCH="${SKILLS_BRANCH:-main}"
SKILLS_SUBDIR="${SKILLS_SUBDIR:-skills}"
SKILLS_DIR="$HOME/.gah/skills-repo"
SKILLS_SSH_KEY="${SKILLS_SSH_KEY:-$CONF_DIR/skills-deploy-key}"

# An agent's own skills. Deliberately outside the shared checkout, which is
# hard-reset on every launch: personal work must survive that. MY_SKILLS_REPO is
# optional — set it to back the directory with the agent's own repository, which
# makes the work recoverable and lets a useful skill be promoted into the shared
# set. Unset, it is just a local directory.
MY_SKILLS_DIR="${MY_SKILLS_DIR:-$HOME/.gah/my-skills}"
MY_SKILLS_REPO="${MY_SKILLS_REPO:-}"
MY_SKILLS_BRANCH="${MY_SKILLS_BRANCH:-main}"

# --- Sync the skills checkout -------------------------------------------------
# The repo is authoritative: every launch hard-resets to origin/<branch>, so
# improvements land by PR merge and local edits never drift. Network failure
# is non-fatal — the existing checkout keeps working offline.

# Never prompt (fresh accounts have no known_hosts; a hidden host-key prompt
# would hang the launch until the timeout). BatchMode makes failures fast.
GIT_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new"
if [ -f "$SKILLS_SSH_KEY" ]; then
	export GIT_SSH_COMMAND="ssh -i $SKILLS_SSH_KEY -o IdentitiesOnly=yes $GIT_SSH_OPTS"
else
	export GIT_SSH_COMMAND="ssh $GIT_SSH_OPTS"
fi

if [ -d "$SKILLS_DIR/.git" ]; then
	if timeout 30 git -C "$SKILLS_DIR" fetch --quiet origin "$SKILLS_BRANCH"; then
		git -C "$SKILLS_DIR" checkout --quiet "$SKILLS_BRANCH" 2>/dev/null \
			|| git -C "$SKILLS_DIR" checkout --quiet -b "$SKILLS_BRANCH" "origin/$SKILLS_BRANCH"
		git -C "$SKILLS_DIR" reset --hard --quiet "origin/$SKILLS_BRANCH"
	else
		warn "skills update failed — continuing with the existing checkout"
	fi
else
	timeout 120 git clone --quiet --branch "$SKILLS_BRANCH" "$SKILLS_REPO" "$SKILLS_DIR" \
		|| warn "skills clone failed — starting without skills"
fi

# --- Sync personal skills (optional) -------------------------------------------
# Note the asymmetry with the shared checkout above, which is `reset --hard`:
# here it is `pull --ff-only`, because personal skills are edited in place and
# uncommitted work must survive a launch. A failure is never fatal — the agent
# keeps whatever is on disk.
if [ -n "$MY_SKILLS_REPO" ]; then
	if [ -d "$MY_SKILLS_DIR/.git" ]; then
		timeout 30 git -C "$MY_SKILLS_DIR" pull --ff-only --quiet 2>/dev/null \
			|| warn "personal skills not updated — continuing with the local copy"
	else
		timeout 120 git clone --quiet --branch "$MY_SKILLS_BRANCH" \
			"$MY_SKILLS_REPO" "$MY_SKILLS_DIR" 2>/dev/null \
			|| warn "personal skills clone failed — continuing without them"
	fi
else
	mkdir -p "$MY_SKILLS_DIR" 2>/dev/null || true
fi

# --- Onboarding / setup steps ---------------------------------------------------
# The skills repo may ship numbered, idempotent setup steps (setup/NN-*.sh)
# that run in the terminal before the TUI — so secrets (e.g. helpdesk
# credentials) are collected without ever passing through the model. Steps
# are agent-authored code, same trust level as the skills themselves; change
# control is the skills repo's PR gate. Failure is non-fatal.

# Swallow whatever arrived while echo was off, then hand back a clean terminal:
# the setup steps below are interactive and need echo for the username prompt.
if [ -t 0 ]; then
	while IFS= read -r -t 0.2 -n 256 _drain 2>/dev/null; do :; done
	unset _drain
	[ -n "$_tty_saved" ] && stty "$_tty_saved" 2>/dev/null || true
	printf '\033[2J\033[H'
fi

if [ -d "$SKILLS_DIR/setup" ]; then
	for step in "$SKILLS_DIR"/setup/[0-9]*.sh; do
		[ -e "$step" ] || continue
		bash "$step" || warn "setup step $(basename "$step") failed — continuing"
	done
fi

# --- Deployment env -----------------------------------------------------------
# Export explicitly: `source` does not export, and GAH_BUILTIN_MODELS must be
# *set* (even if empty) so bin/gah's anthropic/* dev default never applies on
# this host. Empty = deny-all; the manifest grants what this user may see.
# IAM remains the hard enforcement layer (docs/PROVIDERS.md).

export GAH_BUILTIN_MODELS="${GAH_BUILTIN_MODELS-}"
# Empty = models.json is ignored. Exported even when unset so a user's own
# environment cannot switch it on: models.json carries its own baseUrl and
# apiKey, so honouring one here would route around the allowlist entirely.
export GAH_ALLOW_MODELS_JSON="${GAH_ALLOW_MODELS_JSON-}"
export GAH_ALLOW_TOOLS="${GAH_ALLOW_TOOLS-}"
[ -n "${AWS_PROFILE:-}" ] && export AWS_PROFILE
[ -n "${GAH_PROVIDERS_FILE:-}" ] && export GAH_PROVIDERS_FILE

# Staff can't self-update; the build is pinned by the deployment (gah-update).
# Also stops the update check phoning home to pi.dev. (Env name is upstream's,
# not rebranded — see issue #2.)
export PI_SKIP_VERSION_CHECK=1

# --- Launch -------------------------------------------------------------------
# --no-skills disables auto-discovery (~/.gah/agent/skills, <cwd>/.gah/skills);
# the explicit --skill path below is still loaded — same pinning philosophy as
# bin/gah uses for extensions. Sessions start in ~/work, not $HOME.

WORKDIR="${WORKDIR:-$HOME/work}"
mkdir -p "$WORKDIR"
cd "$WORKDIR"

# Skills come from two places, and a personal skill of the same name wins.
#
# The harness does NOT deduplicate: loadSourcedSkills() pushes every skill it
# finds from every --skill path, so passing both directories wholesale would load
# two skills with the same name and leave the model to guess. Precedence has to
# be resolved here.
#
# It is resolved by selection: --skill accepts an individual skill directory (a
# directory containing SKILL.md loads exactly that skill and stops), so shared
# skills that a personal skill shadows are simply never passed. Nothing is copied
# or symlinked, so paths referenced inside a skill still resolve.
#
# A skill's name is its frontmatter `name:` if present, otherwise its directory
# name — the same rule the loader uses — so shadowing is detected the way the
# harness would see it.
skill_name_of() {
	local dir="$1" file="$1/SKILL.md" name=""
	[ -f "$file" ] || return 1
	name=$(awk '
		/^---[[:space:]]*$/ { fence++; next }
		fence == 1 && /^name:[[:space:]]*/ {
			sub(/^name:[[:space:]]*/, "")
			gsub(/^["'"'"']|["'"'"']$/, "")
			print; exit
		}
		fence > 1 { exit }
	' "$file" 2>/dev/null)
	[ -n "$name" ] || name=$(basename "$dir")
	printf '%s\n' "$name"
}

skill_args=()
personal_names=" "

# Personal skills first: they are the ones that win, so they define the shadow set.
if [ -d "$MY_SKILLS_DIR" ]; then
	for d in "$MY_SKILLS_DIR"/*/; do
		[ -d "$d" ] || continue
		d="${d%/}"
		n=$(skill_name_of "$d") || continue
		personal_names="${personal_names}${n} "
		skill_args+=(--skill "$d")
	done
fi

if [ -d "$SKILLS_DIR/$SKILLS_SUBDIR" ]; then
	shared_count=0
	for d in "$SKILLS_DIR/$SKILLS_SUBDIR"/*/; do
		[ -d "$d" ] || continue
		d="${d%/}"
		n=$(skill_name_of "$d") || continue
		case "$personal_names" in
			*" $n "*)
				# Loud on purpose: a shared skill can carry a fix, and being
				# shadowed without notice is how that fix goes missing.
				warn "personal skill '$n' shadows the shared one — the shared version is NOT loaded"
				continue
				;;
		esac
		skill_args+=(--skill "$d")
		shared_count=$((shared_count + 1))
	done
	[ "$shared_count" -eq 0 ] && warn "no shared skills loaded from $SKILLS_DIR/$SKILLS_SUBDIR"
else
	warn "no skills at $SKILLS_DIR/$SKILLS_SUBDIR — launching without shared skills"
fi

# Refuse rather than warn. A session with no skills is a misconfiguration: the
# system prompt is written around skills that are not there, so the agent
# declines ordinary work and the user cannot tell why. The warnings above say
# which half failed -- the clone, or the repo's contents.
if [ ${#skill_args[@]} -eq 0 ]; then
	fail "no skills loaded, refusing to launch.
  Shared repo:   $SKILLS_REPO (branch $SKILLS_BRANCH, subdir $SKILLS_SUBDIR)
  Clone target:  $SKILLS_DIR
Check the warnings above: either the clone failed or the repo has no skills.
To start a deliberately empty session:  GAH_ALLOW_NO_SKILLS=1 $GAH_HOME/bin/gah --no-skills"
fi

exec "$GAH_HOME/bin/gah" --no-skills "${skill_args[@]}"
